# ── قاعدة البيانات ────────────────────────────────────────────────────────────
# داخل Docker Compose استخدم "postgres"، وللتشغيل المباشر استخدم "localhost"
DATABASE_URL=postgresql+asyncpg://ras_user:ras_password@postgres:5432/lawyer_complaints

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── المصادقة (JWT) ────────────────────────────────────────────────────────────
# غيّر هذه القيمة إلى سلسلة عشوائية طويلة في بيئة الإنتاج
SECRET_KEY=change-me-to-a-secure-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ── Anthropic API (الذكاء الاصطناعي) ─────────────────────────────────────────
# احصل على مفتاحك من: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...your-key-here...

# ── MinIO (تخزين مرفقات الشكاوى) ─────────────────────────────────────────────
# داخل Docker Compose استخدم "minio"، وللتشغيل المباشر استخدم "localhost"
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=complaints-evidence
MINIO_SECURE=false

# ── البيئة ────────────────────────────────────────────────────────────────────
# القيم المتاحة: development | production
ENVIRONMENT=development
